{
  "name": "duerp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mock-api": "node mock-api.js",
    "duerp:db:init": "node scripts/duerp/bootstrap.cjs",
    "duerp:db:reset": "node scripts/duerp/bootstrap.cjs --reset",
    "duerp:api:check": "node -e \"console.log('OpenAPI: duerp_pro_spec/specs/openapi.yaml')\"",
    "dev:api": "tsx api/server.ts",
    "config:build:front": "tsx scripts/config/build-front.ts",
    "config:validate": "tsx scripts/config/validate-config.ts",
    "test:api:smoke": "tsx scripts/tests/api-smoke.ts",
    "test:api:integration": "tsx scripts/tests/api-integration.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-table": "^8.11.8",
    "@types/node": "^24.10.1",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7",
    "dotenv": "^16.4.5",
    "pg": "^8.11.3",
    "zod": "^3.23.8",
    "yaml": "^2.6.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.3",
    "tsx": "^4.19.0"
  }
}
