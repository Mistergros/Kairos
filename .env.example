VITE_BYPASS_AUTH=false
# Email Clerk autorisé à voir le back-office interne (/back-office) — laisser vide pour le désactiver
VITE_ADMIN_EMAIL=

# Auth (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_123
CLERK_SECRET_KEY=sk_test_123

