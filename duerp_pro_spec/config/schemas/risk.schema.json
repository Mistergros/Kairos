{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Risk",
  "type": "object",
  "required": [
    "id",
    "family",
    "name",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_scoring": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "frequency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "mastery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "recommended_action_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legal_obligation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}