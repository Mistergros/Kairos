{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnitOfWorkTemplate",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "default_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested": {
      "type": "boolean",
      "default": true
    }
  }
}